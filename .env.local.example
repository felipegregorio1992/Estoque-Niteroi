# Supabase - pegue esses valores em Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Service role key (NUNCA exponha no cliente). Usada só em rotas de servidor
# para criar usuarios (cadastro so por admin).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Segredo do cron de e-mail de alerta (defina na Vercel). Opcional:
# sem ele, o cron e recusado e apenas o envio manual por admin funciona.
CRON_SECRET=um-valor-aleatorio-forte
